# ---- Aplicacion ----
APP_NAME=ms-ficha-residente
# Puerto DENTRO del contenedor
APP_PORT=8004
# Puerto publicado en la VM de produccion (rango del curso: 9000-12000)
PUBLISHED_PORT=9004
APP_ENV=development
LOG_LEVEL=info

# ---- Microservicios consumidos (este servicio NO tiene base de datos) ----
# En la VM de produccion apuntan a la IP privada de esa misma maquina.
MS_RESIDENTES_URL=http://IP-VM-PRODUCCION:9001
MS_PAGOS_URL=http://IP-VM-PRODUCCION:9002
MS_INCIDENCIAS_URL=http://IP-VM-PRODUCCION:9003

# Timeout y reintentos de las llamadas salientes
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=2
